<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="Aurora probe"
        android:icon="@android:drawable/ic_menu_manage"
        android:theme="@android:style/Theme.Material.Light"
        android:largeHeap="true">
        <!-- Extraction is set in app/build.gradle.kts (`useLegacyPackaging = true`), not here: AGP
             warns that the manifest attribute is the wrong place for it and overrides it anyway.
             It matters because the probe is an executable, not a library — it has to be a real file
             on disk with the execute bit set before it can be run as a subprocess. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
